# mjt CLI translations (zh_CN is the source language and superset)
# Namespace: mjt.cli.* = mjt/cli command-line copy
# {n} are positional placeholders, repeatable/reorderable

# ── root / shared ───────────────────────────────────────────
mjt.cli.root.help=JVM bytecode toolkit (info / mapping / jar fix / decompile / strings / xref / classes / disasm / subs / hexdump)
mjt.cli.root.version_help=print version and exit
mjt.cli.opt.input=input path (-i <path>)
mjt.cli.opt.output=output path (-o <path>); must not be the same file as the input
mjt.cli.err.input_missing=input does not exist: {0}
mjt.cli.err.output_missing=an output path is required (-o <path>)

# ── info ────────────────────────────────────────────────────
mjt.cli.info.help=show jar overview: entries, classes, member census, class kinds, entry path shapes, bytecode versions, origins, manifest
mjt.cli.info.json_help=emit the same data as JSON
mjt.cli.info.title=jar overview: {0}
mjt.cli.info.entries=entries: {0}
mjt.cli.info.classes=classes: {0}
mjt.cli.info.members=members: methods {0}, fields {1}, native {2}
mjt.cli.info.method_visibility=method visibility:
