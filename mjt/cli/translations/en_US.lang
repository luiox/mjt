# mjt CLI translations (zh_CN is the source language and superset)
# Namespace: mjt.cli.* = mjt/cli command-line copy
# {n} are positional placeholders, repeatable/reorderable

# ── root / shared ───────────────────────────────────────────
mjt.cli.root.help=JVM bytecode toolkit (info / mapping / jar fix / decompile / strings / xref)
mjt.cli.root.version_help=print version and exit
mjt.cli.opt.input=input path (-i <path>)
mjt.cli.opt.output=output path (-o <path>); must not be the same file as the input
mjt.cli.err.input_missing=input does not exist: {0}
mjt.cli.err.output_missing=an output path is required (-o <path>)

# ── info ────────────────────────────────────────────────────
mjt.cli.info.help=show jar overview: entries, classes, member census, class kinds, entry path shapes, bytecode versions, origins, manifest
mjt.cli.info.json_help=emit the same data as JSON
mjt.cli.info.title=jar overview: {0}
mjt.cli.info.entries=entries: {0}
mjt.cli.info.classes=classes: {0}
mjt.cli.info.members=members: methods {0}, fields {1}, native {2}
mjt.cli.info.method_visibility=method visibility:
mjt.cli.info.field_visibility=field visibility:
mjt.cli.info.origins=class origins:
mjt.cli.info.class_kinds=class kinds:
mjt.cli.info.entry_shapes=entry path shapes:
mjt.cli.info.bytecode_versions=bytecode versions:
mjt.cli.info.manifest=manifest: {0}
mjt.cli.info.manifest_yes=present
mjt.cli.info.manifest_no=absent
mjt.cli.err.info_db=analysis database failure: {0}

# ── mapping ─────────────────────────────────────────────────
mjt.cli.mapping.help=convert mapping files between formats (SRG / Tiny-V2 / Proguard and more); optionally apply the mapping to a jar
mjt.cli.mapping.from_help=source format name (case-insensitive, e.g. srg / tiny-v2 / proguard)
mjt.cli.mapping.to_help=target format name
mjt.cli.mapping.remap_jar_help=input jar to apply the source mapping to (optional)
mjt.cli.mapping.remap_out_help=remapped jar output path (default: <jar stem>-remapped.jar)
mjt.cli.mapping.remap_policy_help=remap policy: bytecode-only (default), reflection, metadata, all
mjt.cli.mapping.remap_done=remapped {0} -> {1} (changed: {2})
mjt.cli.err.mapping_read_failed=cannot read the mapping file: {0}
mjt.cli.err.mapping_write_failed=cannot write the mapping file: {0}
mjt.cli.err.mapping_unknown_format=unknown mapping format: {0} (known formats: {1})
mjt.cli.err.mapping_parse_failed=mapping parse failed: {0}
mjt.cli.err.mapping_format_failed=mapping emit failed: {0}
mjt.cli.err.remap_failed=jar remap failed: {0}

# ── jar fix ─────────────────────────────────────────────────
mjt.cli.jar.help=jar-level diagnostics and repair
mjt.cli.fix.help=diagnose a jar and repair removable damage (invalid class entries, corrupt output markers), writing a repaired copy
mjt.cli.fix.scanned=scanned {0} entries ({1} classes)
mjt.cli.fix.no_issues=no repairable issues found
mjt.cli.fix.issues=issues found: {0}
mjt.cli.fix.removed=removed: {0} [{1}] {2}
mjt.cli.fix.kept=kept: {0} [{1}] {2}
mjt.cli.fix.done=repaired jar written to: {0}
mjt.cli.fix.reason.invalid_class=class bytes did not pass bytecode validation
mjt.cli.fix.reason.invalid_class_entry=a .class entry was not recognized as valid class bytes
mjt.cli.fix.reason.corrupt_output_marker=resource name matches a known corrupt output marker
mjt.cli.err.fix_same_path=input and output must be different files: {0}
mjt.cli.err.fix_output_busy=cannot replace the existing output file: {0}

# ── decompile ───────────────────────────────────────────────
mjt.cli.decompile.help=decompile jar classes to Java sources (CFR / vineflower); single-class mode survives hostile class names
mjt.cli.decompile.class_help=internal name of the class to decompile (slash form, e.g. fixture/Alpha); output goes to -o or stdout
mjt.cli.decompile.all_help=confirm whole-jar batch decompilation (required for batch mode)
mjt.cli.decompile.backend_help=decompiler backend: cfr (default) or vineflower
mjt.cli.decompile.jar_help=explicit decompiler JAR path
mjt.cli.decompile.timeout_help=subprocess timeout in milliseconds (default 120000)
mjt.cli.decompile.memory_help=backend JVM max heap in MiB (default 1024)
mjt.cli.decompile.err.need_mode=either -c <class> (single class) or -o <outdir|.zip> (batch) is required
mjt.cli.decompile.err.batch_output_missing=batch mode requires an output path (-o <outdir> or <out>.zip)
mjt.cli.decompile.err.need_all=batch decompilation covers all {0} classes in the jar; pass --all to confirm
mjt.cli.decompile.err.single_output_java=single-class output must be a .java file (or omit -o to print to stdout)
mjt.cli.decompile.err.class_not_found=class not found in jar: {0}
mjt.cli.decompile.err.open_failed=cannot open jar: {0}
mjt.cli.decompile.err.invalid_value=invalid value for {0}: {1}
mjt.cli.decompile.err.stage_failed=staging failed: {0}
mjt.cli.decompile.err.readback_failed=cannot read back the decompiled source: {0}
mjt.cli.decompile.err.temp_failed=cannot create the decompile temporary directory
mjt.cli.decompile.single_done=decompiled {0}
mjt.cli.decompile.backend_line=backend: {0} ({1})
mjt.cli.decompile.batch_classes=classes: {0}
mjt.cli.decompile.batch_done_dir=sources written to: {0}
mjt.cli.decompile.batch_done_zip=sources archive written to: {0}
mjt.cli.decompile.batch_skipped=skipped {0} entries whose names cannot be written to disk:
mjt.cli.decompile.batch_skipped_reason={0} [{1}]
mjt.cli.decompile.batch_skipped_hint=decompile these via single-class mode (-c <class>), or read them through the jasm text facet
mjt.cli.decompile.reason.segment_too_long=name segment exceeds the 255 UTF-16 unit file system limit
mjt.cli.decompile.reason.illegal_character=name segment contains characters that cannot appear in file names
mjt.cli.decompile.reason.trailing_dot_or_space=name segment ends with a dot or space (stripped by Windows, the file cannot exist)
mjt.cli.decompile.reason.parent_or_self=name contains a relative path segment (. or ..)
mjt.cli.decompile.reason.empty_segment=name contains an empty path segment

# ── strings ─────────────────────────────────────────────────
mjt.cli.strings.help=extract constant-pool strings from jar classes (whole jar or a single class), deduplicated with occurrence counts
mjt.cli.strings.class_help=restrict extraction to one class (internal name, slash form, e.g. fixture/Alpha)
mjt.cli.strings.min_len_help=minimum string length in bytes (default 1)
mjt.cli.strings.json_help=emit the same data as JSON
mjt.cli.strings.output_help=write the full report to a file; stdout keeps the summary only
mjt.cli.strings.title=strings: {0}
mjt.cli.strings.class_filter=class filter: {0}
mjt.cli.strings.scanned=scanned {0} classes (skipped: {1})
mjt.cli.strings.summary=unique strings: {0} (occurrences: {1})
mjt.cli.strings.written=report written to: {0}
mjt.cli.strings.err.invalid_min_len=--min-len must be a positive integer: {0}
mjt.cli.strings.err.class_not_found=class not found in jar: {0}
mjt.cli.strings.err.open_failed=cannot open jar: {0}
mjt.cli.strings.err.write_failed=cannot write the output file: {0}

# ── xref ────────────────────────────────────────────────────
mjt.cli.xref.help=reverse-lookup references to a class or member (to / from / both); output is bounded by --limit
mjt.cli.xref.class_help=class to look up (internal name, slash form, e.g. fixture/Alpha); must exist in the jar
mjt.cli.xref.member_help=optional member selector: name or name(descriptor), e.g. act or act(I)V
mjt.cli.xref.direction_help=reference direction: to (default), from, both
mjt.cli.xref.limit_help=maximum number of reference lines (default 200); raise it after the truncation hint
mjt.cli.xref.json_help=emit the same data as JSON
mjt.cli.xref.title=xref: {0}
mjt.cli.xref.class=class: {0}
mjt.cli.xref.member=member: {0}
mjt.cli.xref.direction=direction: {0}
mjt.cli.xref.counted=references: {0}
mjt.cli.xref.of=of
mjt.cli.xref.truncated=truncated; pass --limit {0} or higher to see all
mjt.cli.xref.class_header=(class header)
mjt.cli.xref.err.invalid_direction=invalid direction: {0} (expected to / from / both)
mjt.cli.xref.err.invalid_member=invalid member selector: {0} (expected name or name(descriptor))
mjt.cli.xref.err.invalid_limit=--limit must be a positive integer: {0}
mjt.cli.xref.err.class_not_found=class not found in jar: {0}
mjt.cli.xref.err.open_failed=cannot open jar: {0}
mjt.cli.xref.err.scan_failed=reference scan failed: {0}
